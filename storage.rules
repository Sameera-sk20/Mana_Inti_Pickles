rules_version = '2';

// Craft rules based on data in your Firestore database
// Allow write access only to authenticated admin users with proper file constraints
service firebase.storage {
  match /b/{bucket}/o {
    // Product Images:
    // Anyone (customers, visitors) can read and view product photos.
    // Only authenticated store administrators can upload, replace, or delete photos.
    // Limits file size to 10MB and requires an image MIME type.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
